<Page x:Class="CS2ServerPicker.Views.Pages.ServersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:converters="clr-namespace:CS2ServerPicker.Converters"
      xmlns:vm="clr-namespace:CS2ServerPicker.ViewModels"
      d:DataContext="{d:DesignInstance vm:ServersPageViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Loaded="OnPageLoaded"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.CanContentScroll="False">

    <Page.Resources>
        <converters:PingStatusToBrushConverter x:Key="PingStatusToBrush" />
        <converters:PingStatusToBarWidthConverter x:Key="PingStatusToBarWidth" />
        <converters:BoolToFavoriteIconConverter x:Key="BoolToFavoriteIcon" />
        <converters:InverseBoolConverter x:Key="InverseBool" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Toolbar -->
        <Grid Grid.Row="0" Margin="{StaticResource SpacingBottom12}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Search Box -->
            <ui:TextBox Grid.Column="0"
                        PlaceholderText="Search servers..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Icon="{ui:SymbolIcon Search24}"
                        ToolTip="Filter servers by name or region"
                        Margin="0,0,12,0" />

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Command="{Binding ToggleClusterCommand}"
                           Appearance="Secondary"
                           Icon="{ui:SymbolIcon Globe24}"
                           Margin="0,0,6,0">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Content" Value="Cluster" />
                            <Setter Property="ToolTip" Value="Group related servers by region into clusters" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsClustered}" Value="True">
                                    <Setter Property="Content" Value="Uncluster" />
                                    <Setter Property="ToolTip" Value="Show individual servers instead of clustered groups" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>

                <ui:Button Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding RefreshPingsCommand}"
                           Appearance="Secondary"
                           ToolTip="Ping all servers to measure latency"
                           Margin="0,0,6,0" />

                <ToggleButton IsChecked="{Binding AutoRefreshEnabled}"
                              ToolTip="Automatically re-ping servers at a regular interval"
                              Padding="8,6">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Timer24" Margin="0,0,4,0" />
                        <TextBlock Text="Auto" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
        </Grid>

        <!-- Filter Bar -->
        <Grid Grid.Row="1" Margin="{StaticResource SpacingBottom8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- View mode filters -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <RadioButton Content="All"
                             IsChecked="{Binding FilterMode, Converter={converters:StringMatchConverter}, ConverterParameter=All}"
                             GroupName="FilterMode"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Margin="0,0,4,0"
                             ToolTip="Show all servers" />
                <RadioButton Content="Favorites"
                             IsChecked="{Binding FilterMode, Converter={converters:StringMatchConverter}, ConverterParameter=Favorites}"
                             GroupName="FilterMode"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Margin="0,0,4,0"
                             ToolTip="Show only favorited servers" />
                <RadioButton Content="Blocked"
                             IsChecked="{Binding FilterMode, Converter={converters:StringMatchConverter}, ConverterParameter=Blocked}"
                             GroupName="FilterMode"
                             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                             Margin="0,0,4,0"
                             ToolTip="Show only blocked servers" />
            </StackPanel>

            <!-- Region filter -->
            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding RegionFilters}"
                      SelectedItem="{Binding SelectedRegionFilter}"
                      Width="160"
                      ToolTip="Filter servers by geographic region" />
        </Grid>

        <!-- Server List + overlay + sortable headers -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="#"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           FontSize="{StaticResource FontSizeCaption}" />

                <Button Grid.Column="1"
                        Command="{Binding SortCommand}"
                        CommandParameter="Name"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Left">
                    <TextBlock Text="Server"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding SortCommand}"
                        CommandParameter="Latency"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Ping"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding SortCommand}"
                        CommandParameter="Latency"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Value"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button Grid.Column="4"
                        Command="{Binding SortCommand}"
                        CommandParameter="Favorite"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Fav"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>

                <Button Grid.Column="5"
                        Command="{Binding SortCommand}"
                        CommandParameter="Selected"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Sel"
                               FontSize="{StaticResource FontSizeCaption}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Button>
            </Grid>

            <!-- Loading overlay -->
            <Grid Grid.Row="1" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                  Panel.ZIndex="1"
                  Background="#80000000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="48" Height="48" />
                    <TextBlock Text="{Binding StatusText}"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0"
                               FontSize="{StaticResource FontSizeSubheader}"
                               Foreground="White" />
                </StackPanel>
            </Grid>

            <!-- Server List -->
            <ListView Grid.Row="1"
                      x:Name="ServerListView"
                      ItemsSource="{Binding FilteredServers}"
                      SelectionMode="Extended"
                      KeyDown="ServerListView_OnKeyDown"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      Background="{ui:ThemeResource ControlFillColorDefaultBrush}"
                      BorderThickness="1"
                      BorderBrush="{ui:ThemeResource ControlElevationBorderBrush}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="4,0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ServerItemViewModel}">
                        <Grid Margin="0,3" Height="42">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="36" />
                            </Grid.ColumnDefinitions>

                            <!-- Flag -->
                            <Image Grid.Column="0"
                                   Width="24" Height="16"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.Source>
                                    <BitmapImage UriSource="{Binding FlagPath, TargetNullValue={x:Null}}"
                                                 CreateOptions="IgnoreImageCache"
                                                 DecodePixelWidth="48" />
                                </Image.Source>
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Style.Triggers>
                                            <Trigger Property="Source" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!-- Server Name -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Region}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Ping Bar -->
                            <Grid Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                <Border Background="{ui:ThemeResource ControlFillColorDisabledBrush}"
                                        CornerRadius="3"
                                        Height="6" />
                                <Border Background="{Binding PingStatus, Converter={StaticResource PingStatusToBrush}}"
                                        CornerRadius="3"
                                        Height="6"
                                        HorizontalAlignment="Left"
                                        Width="{Binding LatencyMs, Converter={StaticResource PingStatusToBarWidth}}" />
                            </Grid>

                            <!-- Latency Text -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding LatencyDisplay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="{StaticResource FontSizeBodySmall}"
                                       FontWeight="SemiBold"
                                       Foreground="{Binding PingStatus, Converter={StaticResource PingStatusToBrush}}" />

                            <!-- Favorite Toggle -->
                            <Button Grid.Column="4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="4"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="Toggle favorite">
                                <ui:SymbolIcon Symbol="{Binding IsFavorite, Converter={StaticResource BoolToFavoriteIcon}}"
                                              FontSize="16"
                                              Foreground="{StaticResource FavoriteBrush}" />
                            </Button>

                            <!-- Selection Checkbox -->
                            <CheckBox Grid.Column="5"
                                      IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      ToolTip="Select server for bulk actions" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Bottom Action Bar -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                       Content="Select All"
                       Command="{Binding SelectAllCommand}"
                       Appearance="Secondary"
                       ToolTip="Select all servers in the current filtered view"
                       Margin="0,0,6,0" />

            <ui:Button Grid.Column="1"
                       Content="Deselect All"
                       Command="{Binding DeselectAllCommand}"
                       Appearance="Secondary"
                       ToolTip="Deselect all servers in the current filtered view"
                       Margin="0,0,6,0" />

            <ui:Button Grid.Column="3"
                       Content="Block Selected"
                       Command="{Binding BlockSelectedCommand}"
                       Appearance="Caution"
                       Icon="{ui:SymbolIcon ShieldDismiss24}"
                       ToolTip="Add firewall rules to block selected servers"
                       Margin="0,0,6,0" />

            <ui:Button Grid.Column="4"
                       Content="Unblock Selected"
                       Command="{Binding UnblockSelectedCommand}"
                       Appearance="Success"
                       Icon="{ui:SymbolIcon ShieldCheckmark24}"
                       ToolTip="Remove firewall rules to unblock selected servers"
                       Margin="0,0,6,0" />

            <ui:Button Grid.Column="5"
                       Content="Block All"
                       Command="{Binding BlockAllCommand}"
                       Appearance="Danger"
                       Icon="{ui:SymbolIcon ShieldDismiss24}"
                       ToolTip="Add firewall rules to block all servers"
                       Margin="0,0,6,0" />

            <ui:Button Grid.Column="6"
                       Content="Unblock All"
                       Command="{Binding UnblockAllCommand}"
                       Appearance="Success"
                       Icon="{ui:SymbolIcon ShieldCheckmark24}"
                       ToolTip="Remove all firewall rules to unblock every server" />
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="4" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       FontSize="{StaticResource FontSizeCaption}"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="{Binding FilteredServers.Count, StringFormat='{}{0} servers'}"
                           FontSize="{StaticResource FontSizeCaption}"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0" />

                <ui:HyperlinkButton NavigateUri="https://github.com/FN-FAL113/cs2-server-picker"
                                    Content="GitHub"
                                    Padding="4,2" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
