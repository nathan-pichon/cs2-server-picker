<Page x:Class="CS2ServerPicker.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:CS2ServerPicker.ViewModels"
      d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      ScrollViewer.VerticalScrollBarVisibility="Disabled"
      ScrollViewer.CanContentScroll="False">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
        <StackPanel MaxWidth="600" HorizontalAlignment="Left">

            <!-- Header -->
            <TextBlock Text="Settings"
                       FontSize="{StaticResource FontSizeHeading}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="{StaticResource SpacingBottom24}" />

            <!-- Appearance Section -->
            <TextBlock Text="Appearance"
                       FontSize="{StaticResource FontSizeSectionHeader}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="{StaticResource SpacingBottom12}" />

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Theme" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Choose the application color theme"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding SelectedTheme}"
                                  Width="120" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Behavior Section -->
            <TextBlock Text="Behavior"
                       FontSize="{StaticResource FontSizeSectionHeader}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,20,0,12" />

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Check for Updates" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Automatically check for new versions on startup"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleButton Grid.Column="1"
                                      IsChecked="{Binding CheckForUpdates}" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Auto-Refresh Interval" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="How often to re-ping servers (0 = disabled)"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding RefreshIntervals}"
                                  SelectedItem="{Binding AutoRefreshInterval}"
                                  Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding StringFormat='{}{0}s'}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding}" Value="0">
                                                        <Setter Property="Text" Value="Disabled" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Ping Section -->
            <TextBlock Text="Ping"
                       FontSize="{StaticResource FontSizeSectionHeader}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,20,0,12" />

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Max Ping Bar Threshold" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Latency (ms) at which the ping bar is full and red"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding MaxPingBarOptions}"
                                  SelectedItem="{Binding MaxPingBarMs}"
                                  Width="120">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='{}{0} ms'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Firewall Section -->
            <TextBlock Text="Firewall"
                       FontSize="{StaticResource FontSizeSectionHeader}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,20,0,12" />

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Firewall Status" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding FirewallStatus, TargetNullValue='Click Check to verify'}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="Check"
                                   Command="{Binding CheckFirewallCommand}"
                                   Appearance="Secondary" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Reset Firewall" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="Reset Windows Firewall to default settings (use with caution)"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="Reset"
                                   Command="{Binding ResetFirewallCommand}"
                                   Appearance="Danger" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- Updates Section -->
            <TextBlock Text="Updates"
                       FontSize="{StaticResource FontSizeSectionHeader}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,20,0,12" />

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Manual Update Check" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding StatusText, TargetNullValue='Click to check for updates'}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ui:Button Grid.Column="1"
                                   Content="Check Now"
                                   Command="{Binding CheckForUpdateCommand}"
                                   Appearance="Secondary" />
                    </Grid>
                </ui:CardControl.Header>
            </ui:CardControl>

            <!-- About Section -->
            <TextBlock Text="About"
                       FontSize="{StaticResource FontSizeSectionHeader}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Margin="0,20,0,12" />

            <ui:CardControl Margin="{StaticResource SpacingBottom8}">
                <ui:CardControl.Header>
                    <StackPanel>
                        <TextBlock Text="CS2 Server Picker"
                                   FontWeight="SemiBold"
                                   FontSize="{StaticResource FontSizeSubheader}"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock FontSize="{StaticResource FontSizeBodySmall}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0">
                            <Run Text="Version:" />
                            <Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock FontSize="{StaticResource FontSizeBodySmall}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0"
                                   Text="Author: FN-FAL113" />
                        <TextBlock FontSize="{StaticResource FontSizeBodySmall}"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Margin="0,2,0,0"
                                   Text="License: GNU General Public License V3" />

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:HyperlinkButton NavigateUri="https://github.com/FN-FAL113/cs2-server-picker"
                                                Content="GitHub"
                                                Padding="4,2"
                                                Margin="0,0,12,0" />
                            <ui:HyperlinkButton NavigateUri="https://www.paypal.com/paypalme/fnfal113"
                                                Content="Donate (PayPal)"
                                                Padding="4,2" />
                        </StackPanel>
                    </StackPanel>
                </ui:CardControl.Header>
            </ui:CardControl>
        </StackPanel>
    </ScrollViewer>
</Page>
